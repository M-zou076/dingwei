{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-travel-assistant",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CROWD_HUB",
        "class_name": "CrowdHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CrowdHub"]
    }
  ]
}
